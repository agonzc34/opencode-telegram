{
  "name": "opencode-telegram",
  "version": "0.1.0",
  "description": "OpenCode plugin: answer permissions and questions from Telegram",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agonzc34/opencode-telegram.git"
  },
  "homepage": "https://github.com/agonzc34/opencode-telegram#readme",
  "bugs": {
    "url": "https://github.com/agonzc34/opencode-telegram/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "telegram",
    "notifications",
    "permissions",
    "questions"
  ],
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --external @opencode-ai/plugin --external @opencode-ai/sdk --external grammy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "bun run build"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.0",
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  }
}
